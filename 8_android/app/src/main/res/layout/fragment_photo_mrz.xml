<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:text="PHOTO → MRZ"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_photo_method"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="算法: 自动" />

            <CheckBox
                android:id="@+id/cb_photo_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="全部方案"
                android:textColor="@color/text" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="默认自动(链式短路)；全部方案模式保留每个算法的独立结果"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_photo_pick"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_photo_sample"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="From sample" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_photo_run"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/neon_cyan"
                android:text="Run pipeline"
                android:textColor="@color/bg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_photo_batch"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="批量测试" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_photo_batch_group"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="图片源: 全部" />
        </LinearLayout>

        <TextView
            android:id="@+id/photo_status"
            style="@style/ValMono"
            android:layout_marginTop="8dp"
            android:text="select a passport photo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:text="PIPELINE STAGES"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/photo_stage_labels"
            style="@style/ValMono"
            android:layout_marginTop="6dp"
            android:text="① original   ② reflection removed   ③ MRZ crop" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="2">

            <ImageView
                android:id="@+id/photo_original"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@color/field"
                android:contentDescription="original passport photo"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/photo_clean"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@color/field"
                android:contentDescription="reflection removed photo"
                android:scaleType="fitCenter" />

            <!-- MRZ crop 横跨两列：它是宽而矮的一条，两行各占半屏会把它
                 压成看不清的一小格。 -->
            <ImageView
                android:id="@+id/photo_mrz"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:background="@color/field"
                android:contentDescription="MRZ crop"
                android:scaleType="fitCenter" />
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:text="RESULT"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/photo_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/field"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="ready to run"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
