Makefile
_deps/

# Python trainer caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# MRZ / face / nfc test corpus (regenerable) + per-bench failure exports.
# Ignore only the generated corpus dirs; keep data/baseline.json (the
# regression-gate reference) and any future hand-written data tracked.
6_mrz_ocr/data/corpus/
6_mrz_ocr/data/corpus_eval/
6_mrz_ocr/data/corpus_train/
6_mrz_ocr/data/corpus_eval_v2/
6_mrz_ocr/data/corpus_train_v2/
6_mrz_ocr/data/corpus_train_v3/
6_mrz_ocr/data/hard_slices.npz
6_mrz_ocr/failures_*.json
# Exported training slices (regenerable from the corpora above; 100-300 MB
# each).  The corpora are locked by data/manifests/*.manifest.json, so
# regenerating them and re-signing is the documented path.
6_mrz_ocr/data/synth_extra_*.npz
6_mrz_ocr/data/crnn_combined.npz
6_mrz_ocr/data/crnn_*.npz
# Pre-retrain weight-header backups (local rollback aid).
6_mrz_ocr/weights_backup_*/
# NOTE: 6_mrz_ocr/data/manifests/ is deliberately NOT ignored -- the
# sha256 manifests are the corpus distribution lock and must be reviewed
# and committed together with any corpus change.
3_face_recognition/tests/data/
4_nfc_reader/data/*.json

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
assets/

# Local venv used for CustomTkinter preview (do not commit)
.venv-ctk/

# Pre-edit backups (kept as safety net during visual iteration)
*.bak.pre-visual-pass-*

# Local scratch skills are not committed.  The vendored AI-Research-SKILLs
# snapshot IS tracked: AGENTS.md makes it mandatory for all model training /
# recognition work, so clones must receive it.  See skills/AI-Research-SKILLs/
# VENDOR_PIN.md for the pin, the pruning scope and the upgrade procedure.
skills/*
!skills/AI-Research-SKILLs/
!skills/AI-Research-SKILLs/**

